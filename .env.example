# Snackify environment settings.
# On Render: open the web service > Environment and add these. Never commit real values to GitHub.
# For local testing: copy this file to .env and fill it in (.env is ignored by git).

# ---- Required ----
NODE_ENV=production
DATABASE_URL=                 # Render fills this from the database automatically
JWT_SECRET=                   # Render can generate this (generateValue). Any long random text works locally.
ADMIN_USERNAME=raven
ADMIN_PASSWORD=               # Choose a strong password. Keep it private.

# ---- AI assistant (Ask AI, tutorial guide) ----
# Add at least one provider key. The assistant tries them in order.
GROQ_API_KEY=
GEMINI_API_KEY=               # also used for the voice (text-to-speech)
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
AIMLAPI_API_KEY=
EDENAI_API_KEY=
HUGGINGFACE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# AI_PROVIDERS=groq,gemini    # optional: choose which providers to use, in this order
# AI_SPOTLIGHT_SCOPE=shop     # optional: keep customers to shop topics only (default: general help too)
# AI_CURRENCY=PHP             # optional
# AI_SHOP_INFO=               # optional: facts about the shop the assistant should know
# GEMINI_VOICE=Kore           # optional: voice name for the tutorial voice
# GEMINI_TTS_MODEL=           # optional: change only if Google retires the default model

# ---- Order alerts (push notifications) ----
# Make the two keys once, on your computer: npx web-push generate-vapid-keys
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:ravencastillo258@gmail.com

# ---- Loyalty points ----
# PESO_PER_POINT=10           # optional: pesos spent per point on a delivered order (default 10)

# ---- Time zones ----
# SHOP_TZ=Asia/Manila         # optional
# REPORT_TZ=Asia/Manila       # optional

# ---- Optional: safety and performance ----
# ALLOWED_ORIGINS=            # optional: extra sites allowed to call the API
# ALLOWED_HOSTS=              # optional
# BACKUP_KEY=                 # optional: key used to encrypt backups
# BLOCK_COUNTRIES=            # optional: country codes to block
# DDOS_ALLOW=                 # optional: addresses that are never rate-limited
# PG_POOL_MAX=10              # optional: database connections
# RAM_LIMIT_MB=               # optional
# SECURITY_CONTACT=           # optional: shown to people reporting security issues
# IMAGE_AVIF=                 # optional: serve product photos in AVIF format
# RENDER_EXTERNAL_URL=        # set automatically by Render
# PORT=                       # set automatically by Render

# ---- Do not set these ----
# NTFY_TOPIC and TELEGRAM_* are for notifications you chose not to use.
